# Copy to backend/.env. Never commit the real file.
NODE_ENV=development
PORT=4000

# Must be a replica set: leave approvals and balance changes use transactions.
# In production use a dedicated least-privilege user and TLS, for example:
# mongodb+srv://leavehub_app:<password>@cluster.example.mongodb.net/leave_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/leave_hub?replicaSet=rs0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Exact origins allowed to call the API with credentials, comma separated.
CORS_ORIGINS=http://localhost:5173
# Used to build password reset and activation links.
APP_URL=http://localhost:5173
# Defaults to true in production. Leave blank unless you have a reason.
COOKIE_SECURE=
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API. Needed for correct client IPs and rate limits.
TRUST_PROXY=0

# Outside any public directory. In production, mount private storage here.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=4
# Optional malware scanning through clamd. CLAMAV_REQUIRED=true rejects uploads if it is down.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# Optional email. Without SMTP_HOST, activation links are shown to the admin who created the account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=WorkNest <no-reply@example.com>
# Testing only: sends every email to this one address. The server refuses to start with it in production.
EMAIL_REDIRECT_TO=

# Optional Cloudinary storage for documents and profile photos. Without these, files are saved in UPLOAD_DIR.
# Cloud name: the lowercase ID on the Cloudinary dashboard (e.g. dq3x9abcd), not the product environment name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Encrypts bank details. Create one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe and do not change it: bank details saved with it cannot be read without it.
FIELD_ENCRYPTION_KEY=

# Only when the API runs on a separate host behind a proxy: requests without this header value are refused.
# Leave empty when everything runs on Vercel.
ORIGIN_SECRET=

# On Vercel: a long random value. Vercel Cron Jobs send it to run the daily jobs and the punch reminder.
CRON_SECRET=

# Optional Outlook and Teams Out of office, for a work Microsoft 365 organisation. See docs/DEPLOYMENT.md.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SENSITIVE_MAX=120
RATE_LIMIT_GLOBAL_MAX=3000

# Run scheduled jobs (accrual, expiry, reminders, email) on this instance.
JOBS_ENABLED=true
LOG_LEVEL=info

# Serve the built React app from Express in production, for example ../frontend/dist
CLIENT_DIST=

# Used by `npm run seed`. In production the seed creates only baseline configuration and this account.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Development seed only: the password for every demo account. Random if blank.
SEED_PASSWORD=
